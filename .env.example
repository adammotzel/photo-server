# Copy to `.env` and fill in the values. See docs/setup/02_CONFIG.md

# pet name
NAME=

# LAN
NETWORK_NAME=

# db details
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="photoapp"
DB_USER="photoapp_user"
DB_PASSWORD=

# pgsql admin password -- optional for .env, but it's at least needed on host
DB_PGSQL_PW=

# app details
SERVER_IP="0.0.0.0"
SERVER_PORT="8000"

# self-signed certs (.pem file paths)
SSL_CERTFILE=
SSL_KEYFILE=

# openai
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TIMEOUT_S=30
OPENAI_MAX_RETRIES=1

# managed by scripts/build.sh - the image tag docker compose runs
PHOTO_SERVER_TAG=
